{
  "context": {
    "tools": {
      "max_calls": 250,
      "keep_last": 50,
      "strip_inputs": true
    }
  },
  "skills": ["update-docs"],
  "agents": ["code/review", "code/explore"],
  "permission": {
    "deny": {
      "bash": {
        "arguments": {
          "command": ["^rm", "\\&\\&\\s*rm"]
        }
      }
    },
    "allow": {
      "bash": {
        "arguments": {
          "command": ["^git diff", "^git status", "^git log"]
        }
      },
      "grep": {
        "arguments": {
          "pattern": [".*"],
          "glob": ["\\.lua$"]
        }
      },
      "view": {
        "arguments": {
          "path": ["\\.lua$", "README\\.md$"]
        }
      },
      "fetch": {
        "arguments": {
          "url": [
            "^https://github\\.com/",
            "^https://raw\\.githubusercontent\\.com/"
          ]
        }
      }
    }
  }
}
